#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../config/ai-stack.env"


LOG_DIR="${AI_HOME}/logs"
DAYS=30

usage() {
  cat <<EOF
Usage: ai-cost [command] [options]

Commands:
  local  [--days N]          Cost estimate from headroom log (default: last 30 days)
  aws    [--days N]          Actual AWS Bedrock costs via Cost Explorer
  all    [--days N]          Both local + AWS side by side

Options:
  --days N    Number of days to look back (default: 30)
  --all       All time, no window

Examples:
  ai-cost local
  ai-cost aws --days 14
  ai-cost all --days 7
EOF
}

# Parse --days flag
_parse_days() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) DAYS="$2"; shift 2 ;;
      --all)  DAYS=1095; shift ;;  # 3 years — AWS Cost Explorer max is 37 months
      *) shift ;;
    esac
  done
}

# ISO date N days ago (macOS + Linux compatible)
_date_ago() {
  local n="$1"
  if date --version &>/dev/null 2>&1; then
    date -d "${n} days ago" +%Y-%m-%d
  else
    date -j -v-${n}d +%Y-%m-%d
  fi
}

# Normalize Bedrock model name to pricing key
_model_key() {
  local m="$1"
  m="${m##eu.anthropic.}"   # strip cross-region prefix
  m="${m%%-2025*}"          # strip date suffix
  m="${m%%:*}"              # strip version suffix
  echo "$m"
}

# --- local: parse headroom log ---
cmd_local() {
  _parse_days "$@"

  local since
  since=$(_date_ago "$DAYS")

  # Collect all headroom log files (dated + legacy)
  local log_files=()
  for f in "${LOG_DIR}"/headroom-*.log "${LOG_DIR}"/headroom.log; do
    [[ -f "$f" ]] && log_files+=("$f")
  done

  if [[ ${#log_files[@]} -eq 0 ]]; then
    echo "error: no headroom logs found in $LOG_DIR" >&2
    exit 1
  fi

  python3 - "$since" "${log_files[@]}" <<'PYEOF'
import sys, json
from collections import defaultdict

since = sys.argv[1]
log_files = sys.argv[2:]

PRICING = {
    'claude-sonnet-5':   (0.003,  0.015),
    'claude-sonnet-4-6': (0.003,  0.015),
    'claude-sonnet-4-5': (0.003,  0.015),
    'claude-sonnet-4':   (0.003,  0.015),
    'claude-opus-5':     (0.015,  0.075),
    'claude-opus-4-6':   (0.015,  0.075),
    'claude-opus-4-5':   (0.015,  0.075),
    'claude-haiku-4-5':  (0.0008, 0.004),
    'claude-fable-5':    (0.003,  0.015),
}

def model_key(m):
    m = m.replace('eu.anthropic.', '')
    import re
    m = re.sub(r'-2025\d{4}', '', m)
    for suffix in ['-v1:0', '-v1']:
        m = m.replace(suffix, '')
    return m

by_day   = defaultdict(lambda: {'reqs': 0, 'input': 0, 'output': 0, 'saved': 0, 'cost': 0.0})
by_model = defaultdict(lambda: {'reqs': 0, 'input': 0, 'output': 0, 'cost': 0.0})
totals   = {'reqs': 0, 'input_orig': 0, 'input_opt': 0, 'output': 0, 'saved': 0, 'cost': 0.0}

for log_file in log_files:
    for line in open(log_file):
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except:
            continue
        day = r.get('timestamp', '')[:10]
        if day < since:
            continue

        mk    = model_key(r.get('model', ''))
        inp   = r.get('input_tokens_optimized', 0)
        out   = r.get('output_tokens', 0)
        saved = r.get('tokens_saved', 0)
        ip, op = PRICING.get(mk, (0.003, 0.015))
        cost  = (inp / 1000 * ip) + (out / 1000 * op)

        by_day[day]['reqs']   += 1
        by_day[day]['input']  += inp
        by_day[day]['output'] += out
        by_day[day]['saved']  += saved
        by_day[day]['cost']   += cost

        by_model[mk]['reqs']   += 1
        by_model[mk]['input']  += inp
        by_model[mk]['output'] += out
        by_model[mk]['cost']   += cost

        totals['reqs']       += 1
        totals['input_orig'] += r.get('input_tokens_original', 0)
        totals['input_opt']  += inp
        totals['output']     += out
        totals['saved']      += saved
        totals['cost']       += cost

if not by_day:
    print(f"No headroom activity since {since}")
    sys.exit(0)

print(f"\n── Headroom local estimate (since {since}) ──\n")
print(f"  Requests : {totals['reqs']:,}")
print(f"  Input    : {totals['input_orig']:,} tokens original → {totals['input_opt']:,} optimized")
print(f"  Output   : {totals['output']:,} tokens")
savings_pct = totals['saved'] / totals['input_orig'] * 100 if totals['input_orig'] else 0
print(f"  Saved    : {totals['saved']:,} tokens ({savings_pct:.1f}% compression)")
print(f"  Est. cost: ${totals['cost']:.2f}\n")

print(f"  {'Date':<12} {'Reqs':>5} {'Input (opt)':>13} {'Output':>9} {'Saved':>10} {'Est. Cost':>10}")
print(f"  {'-'*12} {'-'*5} {'-'*13} {'-'*9} {'-'*10} {'-'*10}")
for day in sorted(by_day):
    d = by_day[day]
    print(f"  {day:<12} {d['reqs']:>5} {d['input']:>13,} {d['output']:>9,} {d['saved']:>10,} ${d['cost']:>9.2f}")
print(f"  {'TOTAL':<12} {totals['reqs']:>5} {totals['input_opt']:>13,} {totals['output']:>9,} {totals['saved']:>10,} ${totals['cost']:>9.2f}\n")

print(f"  {'Model':<30} {'Reqs':>5} {'Input (opt)':>13} {'Output':>9} {'Est. Cost':>10}")
print(f"  {'-'*30} {'-'*5} {'-'*13} {'-'*9} {'-'*10}")
for mk, d in sorted(by_model.items(), key=lambda x: -x[1]['cost']):
    print(f"  {mk:<30} {d['reqs']:>5} {d['input']:>13,} {d['output']:>9,} ${d['cost']:>9.2f}")
PYEOF
}

# --- aws: query Cost Explorer ---
cmd_aws() {
  _parse_days "$@"

  if ! command -v aws &>/dev/null; then
    echo "error: aws CLI not found" >&2
    exit 1
  fi

  local since end
  since=$(_date_ago "$DAYS")
  end=$(date +%Y-%m-%d)
  # AWS Cost Explorer requires start = first of month when going beyond 14 months
  if (( DAYS > 425 )); then
    since="${since:0:7}-01"
  fi

  local filter='{"Dimensions":{"Key":"SERVICE","Values":["Claude Sonnet 4.6 (Amazon Bedrock Edition)","Claude Sonnet 4.5 (Amazon Bedrock Edition)","Claude Sonnet 4 (Amazon Bedrock Edition)","Claude Haiku 4.5 (Amazon Bedrock Edition)","Claude Opus 4.6 (Amazon Bedrock Edition)","Claude Opus 4.5 (Amazon Bedrock Edition)"]}}'


  echo "\n── AWS Bedrock Claude costs (since ${since}, profile: ${AWS_PROFILE}) ──\n"

  local raw
  raw=$(aws ce get-cost-and-usage \
    --profile "${AWS_PROFILE}" \
    --time-period "Start=${since},End=${end}" \
    --granularity DAILY \
    --filter "$filter" \
    --metrics "UnblendedCost" \
    --group-by Type=DIMENSION,Key=SERVICE)

  echo "$raw" | python3 -c "
import sys, json
from collections import defaultdict

data = json.loads(sys.stdin.read())
by_day   = defaultdict(float)
by_model = defaultdict(float)
total    = 0.0

for r in data['ResultsByTime']:
    day = r['TimePeriod']['Start']
    for g in r['Groups']:
        svc = g['Keys'][0]
        v   = float(g['Metrics']['UnblendedCost']['Amount'])
        if v == 0:
            continue
        by_day[day]   += v
        by_model[svc] += v
        total         += v

if not by_day:
    print('  No Claude charges found.')
    sys.exit(0)

print(f\"  {'Date':<12} {'Cost':>10}\")
print(f\"  {'-'*12} {'-'*10}\")
for day in sorted(by_day):
    print(f\"  {day:<12} \${by_day[day]:>9.2f}\")
print(f\"  {'TOTAL':<12} \${total:>9.2f}\n\")

print(f\"  {'Model':<45} {'Total Cost':>10}\")
print(f\"  {'-'*45} {'-'*10}\")
for svc, v in sorted(by_model.items(), key=lambda x: -x[1]):
    print(f\"  {svc:<45} \${v:>9.2f}\")
"
}

# --- all: both ---
cmd_all() {
  cmd_local "$@"
  cmd_aws "$@"
}

# --- dispatch ---
case "${1:-help}" in
  local)  shift; cmd_local "$@" ;;
  aws)    shift; cmd_aws   "$@" ;;
  all)    shift; cmd_all   "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "error: unknown command '${1}'" >&2; usage; exit 1 ;;
esac
