#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../config/ai-stack.env"

LIB="${AI_HOME}/lib"

# asdf reads .tool-versions from cwd — must run from AI_HOME
_CALLER_DIR="${PWD}"
cd "${AI_HOME}"
trap 'cd "${_CALLER_DIR}"' EXIT

run_install() { echo "  → $1"; source "$2" }

case "${1:-}" in
  -h|--help)
    cat <<EOF
Usage: ai-install

Bootstraps the machine: prerequisites, runtimes, and tooling.

To install services and plugins for the active profile:
  ai-stack install

To install for a specific profile without switching:
  ai-stack install <profile>
EOF
    ;;
  "")
    echo "── setup ──"
    for f in prerequisites runtimes tooling; do
      [[ -f "${LIB}/setup/${f}" ]] && run_install "$f" "${LIB}/setup/${f}"
    done
    for f in "${LIB}"/setup/*/install(N); do
      run_install "$(basename "$(dirname "$f")")" "$f"
    done
    echo ""
    echo "✓ Bootstrap complete."
    echo "  Next: ai-stack profile <name> && ai-stack install"
    ;;
  *)
    echo "error: unknown argument '${1}'" >&2
    echo "Use: ai-install" >&2
    exit 1
    ;;
esac
