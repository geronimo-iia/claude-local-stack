#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../config/ai-stack.env"

LIB="${AI_HOME}/lib"

# asdf reads .tool-versions from cwd — must run from AI_HOME
_CALLER_DIR="${PWD}"
cd "${AI_HOME}"
trap 'cd "${_CALLER_DIR}"' EXIT

run_install() { echo "  → $1"; source "$2" }

install_setup() {
  echo "── setup ──"
  for f in prerequisites runtimes tooling; do
    [[ -f "${LIB}/setup/${f}" ]] && run_install "$f" "${LIB}/setup/${f}"
  done
  for f in "${LIB}"/setup/*/install(N); do
    run_install "$(basename "$(dirname "$f")")" "$f"
  done
}

install_category() {
  local category="$1"
  echo "── ${category} ──"
  local items=()
  for dir in "${LIB}/${category}"/*(N/); do
    local pri=50
    [[ -f "${dir}/priority" ]] && pri=$(<"${dir}/priority")
    [[ -f "${dir}/install" ]] && items+=("${pri}:${dir}")
  done
  for entry in ${(on)items}; do
    local dir="${entry#*:}"
    run_install "$(basename "$dir")" "${dir}/install"
  done
}

case "${1:-all}" in
  -h|--help)
    cat <<EOF
Usage: ai-install [all|setup|services|plugins]

Targets:
  all        Install everything (default)
  setup      Bootstrap (prerequisites, runtimes, tooling, claude-code)
  services   All services (sorted by priority)
  plugins    All plugins (sorted by priority)

For individual components use:
  ai-stack plugin  {install|upgrade|remove} <name...>
  ai-stack service {install|upgrade|remove} <name...>
EOF
    ;;
  all)
    install_setup
    install_category services
    install_category plugins
    echo ""
    echo "✓ ai-stack installed."
    echo "  Next: ai-stack profile default"
    ;;
  setup)    install_setup ;;
  services) install_category services ;;
  plugins)  install_category plugins ;;
  *)
    echo "error: unknown target '${1}'" >&2
    echo "Use: ai-install [all|setup|services|plugins]" >&2
    echo "     ai-stack plugin/service {install|upgrade|remove} <name>" >&2
    exit 1
    ;;
esac
