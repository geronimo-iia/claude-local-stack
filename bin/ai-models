#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../config/ai-stack.env"

# ensure hf cli is available
if ! command -v hf &>/dev/null; then
  echo "error: 'hf' command not found. Run 'ai-stack install setup'" >&2
  exit 1
fi

# Ensure manifest is installed
MANIFEST="${AI_HOME}/config/models.yaml"

if [[ ! -f "$MANIFEST" ]]; then
  echo "error: manifest not found at $MANIFEST" >&2
  exit 1
fi

# Load secrets into env
eval "$("$(dirname "$0")/ai-secrets" env 2>/dev/null)" || true

parse_repos() {
  local category="$1"
  awk -v cat="$category" '
    /^[a-z]+:/ { current=$1; gsub(/:/, "", current); next }
    current == cat && /^ *- / { gsub(/^ *- */, ""); print }
  ' "$MANIFEST"
}

pull_category() {
  local category="$1"
  local repos=$(parse_repos "$category")
  [[ -z "$repos" ]] && return 0
  echo "── ${category} ──"
  while read -r repo; do
    echo "  ↓ ${repo}…"
    hf download "$repo" --quiet
    echo "  ✓ ${repo}"
  done <<< "$repos"
}

pull_ollama_category() {
  local repos=$(parse_repos "ollama")
  [[ -z "$repos" ]] && return 0
  if ! command -v ollama &>/dev/null; then
    echo "warning: 'ollama' not found — skipping ollama models" >&2
    return 0
  fi
  echo "── ollama ──"
  while read -r model; do
    echo "  ↓ ${model}…"
    ollama pull "$model"
    echo "  ✓ ${model}"
  done <<< "$repos"
}

list_ollama_models() {
  local repos=$(parse_repos "ollama")
  [[ -z "$repos" ]] && return 0
  if ! command -v ollama &>/dev/null; then
    echo "ollama: (ollama not installed)"
    return 0
  fi
  local pulled
  pulled=$(ollama list 2>/dev/null | awk 'NR>1 {print $1}' | sed 's/:latest$//')
  echo "ollama:"
  while read -r model; do
    if echo "$pulled" | grep -qx "$model"; then
      echo "  ✓ ${model}"
    else
      echo "  ✗ ${model}"
    fi
  done <<< "$repos"
}

list_models() {
  for category in llm embedding; do
    local repos=$(parse_repos "$category")
    [[ -z "$repos" ]] && continue
    echo "${category}:"
    while read -r repo; do
      local cache_name="models--${repo//\//-}"
      local hf_cache="${HF_HUB_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/huggingface/hub}"
      if [[ -d "${hf_cache}/${cache_name}" ]]; then
        echo "  ✓ ${repo}"
      else
        echo "  ✗ ${repo}"
      fi
    done <<< "$repos"
  done
  list_ollama_models
}

usage() {
  cat <<EOF
Usage: ai-models <command> [target...]

Commands:
  pull [target]   Download models (all, a category, or a repo ID)
  list            Show manifest with download status

Examples:
  ai-models pull                              # download all (hf + ollama)
  ai-models pull llm                          # just LLMs (HuggingFace)
  ai-models pull embedding                    # just embeddings (HuggingFace)
  ai-models pull ollama                       # just Ollama models
  ai-models pull mlx-community/bge-m3-4bit   # one specific HuggingFace model
  ai-models list                              # show status
EOF
}

case "${1:-}" in
  pull)
    shift
    if [[ $# -eq 0 ]]; then
      for cat in llm embedding; do pull_category "$cat"; done
      pull_ollama_category
    else
      for target in "$@"; do
        case "$target" in
          llm|embedding) pull_category "$target" ;;
          ollama) pull_ollama_category ;;
          *) hf download "$target" --quiet ;;
        esac
      done
    fi
    ;;
  list) list_models ;;
  -h|--help|"") usage ;;
  *) echo "error: unknown command '${1}'" >&2; usage; exit 1 ;;
esac
