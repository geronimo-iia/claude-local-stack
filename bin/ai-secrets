#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../config/ai-stack.env"
export AI_HOME

SECRETS_DIR="$AI_HOME/secrets"                    # secrets root directory
SOPS_FILE="$SECRETS_DIR/api-keys.sops.yaml"       # encrypted secrets file
SOPS_CONFIG="$SECRETS_DIR/.sops.yaml"             # SOPS creation rules (age public key)
AGE_KEY="$SECRETS_DIR/age-key.txt"                # age private key (never commit)

export SOPS_AGE_KEY_FILE="$AGE_KEY"

case "${1:-help}" in
  init)
    # Generate age key + sops config
    if [[ -f "$AGE_KEY" ]]; then
      echo "Age key already exists: $AGE_KEY"
      exit 1
    fi
    mkdir -p "$SECRETS_DIR"
    age-keygen -o "$AGE_KEY" 2>&1 | tee /dev/stderr | grep "public key" | awk '{print $NF}' | {
      read pubkey
      cat > "$SOPS_CONFIG" <<EOF
creation_rules:
  - age: '$pubkey'
EOF
    }
    echo "✓ Age key created: $AGE_KEY"
    echo "✓ SOPS config created: $SOPS_CONFIG"
    ;;
  edit)
    # Edit secrets (decrypts, opens editor, re-encrypts on save)
    sops "$SOPS_FILE"
    ;;
  create)
    # Create secrets file from sample
    if [[ -f "$SOPS_FILE" ]]; then
      echo "Secrets file already exists. Use 'ai-secrets edit' instead."
      exit 1
    fi
    if [[ ! -f "$AGE_KEY" ]]; then
      echo "No age key found. Run 'ai-secrets init' first."
      exit 1
    fi
    sops "$SOPS_FILE"
    echo "✓ Secrets file created: $SOPS_FILE"
    ;;
  get)
    # Read a single key
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: ai-secrets get <key>"
      exit 1
    fi
    sops -d --extract "[\"$1\"]" "$SOPS_FILE"
    ;;
  list)
    # Show all keys (names only, not values)
    sops -d "$SOPS_FILE" | grep -E "^[a-zA-Z_]" | cut -d: -f1
    ;;
  show)
    # Show all decrypted values
    sops -d "$SOPS_FILE"
    ;;
  env)
    # Output as exportable env vars (for eval/source)
    if [[ ! -f "$SOPS_FILE" ]]; then
      exit 0
    fi
    sops -d --output-type dotenv "$SOPS_FILE"
    ;;
  rotate)
    # Rotate encryption key
    echo "Rotating keys for: $SOPS_FILE"
    sops updatekeys "$SOPS_FILE"
    echo "✓ Keys rotated"
    ;;
  *)
    echo "Usage: ai-secrets {init|create|edit|get|list|show|env|rotate}"
    echo ""
    echo "Commands:"
    echo "  init               Generate age key + SOPS config"
    echo "  create             Create encrypted secrets file"
    echo "  edit               Edit secrets (decrypt → editor → re-encrypt)"
    echo "  get <key>          Print a single decrypted value"
    echo "  list               Show key names (no values)"
    echo "  show               Show all decrypted key/values"
    echo "  env                Output as KEY=VALUE lines (for eval)"
    echo "  rotate             Rotate encryption keys"
    echo ""
    echo "Files:"
    echo "  $AGE_KEY"
    echo "  $SOPS_FILE"
    ;;
esac
