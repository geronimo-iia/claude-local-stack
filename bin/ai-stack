#!/bin/zsh
set -euo pipefail

# --- Bootstrap ---

source "$(dirname "$0")/../config/ai-stack.env"

# asdf reads .tool-versions from cwd — must run from AI_HOME
_CALLER_DIR="${PWD}"
cd "${AI_HOME}"
trap 'cd "${_CALLER_DIR}"' EXIT

if ! command -v overmind &>/dev/null; then
  echo "error: overmind not found. Run: ai-install" >&2
  exit 1
fi

# Decrypt and export secrets (API keys, tokens)
source <("$(dirname "$0")/ai-secrets" env 2>/dev/null)

# --- Helpers ---

# Poll until overmind socket disappears (max ~5s)
_wait_socket_gone() {
  local i=0
  while [[ -S "$OVERMIND_SOCKET" ]] && (( i++ < 25 )); do sleep 0.2; done
}

# Poll until overmind socket appears (max ~5s)
_wait_socket_ready() {
  local i=0
  while [[ ! -S "$OVERMIND_SOCKET" ]] && (( i++ < 25 )); do sleep 0.2; done
}

# Restart the stack only if it's currently running
_restart_if_running() {
  if overmind ps &>/dev/null; then
    overmind quit 2>/dev/null || true
    _wait_socket_gone
    overmind start -D
    echo "✓ Stack restarted"
  fi
}

# Ensure all given service names exist in the active Procfile
_validate_services() {
  for svc in "$@"; do
    if ! grep -qE "^#?${svc}:" "${OVERMIND_PROCFILE}"; then
      echo "error: unknown service '$svc'" >&2
      echo "Available: $(grep -oE '^#?[a-zA-Z_-]+' "${OVERMIND_PROCFILE}" | sed 's/^#//' | tr '\n' ' ')" >&2
      exit 1
    fi
  done
}

# --- Profile management ---
# A profile is a self-contained stack config (ccr.json + Procfile + optional rapid-mlx.yaml)
# stored in config/profiles/<name>/. Activation copies files to their runtime locations.

# Resolve the directory for a given profile name
_profile_dir() {
  echo "${AI_HOME}/config/profiles/$1"
}

# Read the currently active profile (or "none")
_current_profile() {
  local state="${AI_HOME}/config/.active-profile"
  if [[ -f "$state" ]]; then
    cat "$state"
  else
    echo "none"
  fi
}

# Activate a profile: copy its configs to runtime locations
_activate_profile() {
  local name="$1"
  local dir
  dir="$(_profile_dir "$name")"

  if [[ ! -d "$dir" ]]; then
    echo "error: unknown profile '$name'" >&2
    echo "Available: $(ls "${AI_HOME}/config/profiles" | tr '\n' ' ')" >&2
    exit 1
  fi

  # CCR routing config → ~/.claude-code-router/config.json
  mkdir -p "$HOME/.claude-code-router"
  if [[ -f "$dir/ccr.json" ]]; then
    cp "$dir/ccr.json" "$HOME/.claude-code-router/config.json"
  fi

  # rapid-mlx instance definitions (optional — cloud profile has none)
  if [[ -f "$dir/rapid-mlx.yaml" ]]; then
    cp "$dir/rapid-mlx.yaml" "${AI_HOME}/config/rapid-mlx.yaml"
  fi

  # LiteLLM multi-provider config (optional — only multi profile has this)
  if [[ -f "$dir/litellm.yaml" ]]; then
    cp "$dir/litellm.yaml" "${AI_HOME}/config/litellm.yaml"
  fi

  # Procfile → active service definitions for overmind
  cp "$dir/Procfile" "${OVERMIND_PROCFILE}"

  # Auto-install services if enabled
  if [[ "${AI_STACK_AUTO_INSTALL:-false}" == "true" ]]; then
    _install_yaml_deps "${AI_HOME}/config/base-services.yaml"
    _install_yaml_deps "$dir/services.yaml"
  fi

  # Record active profile name
  echo "$name" > "${AI_HOME}/config/.active-profile"
}

# --- Dep checking ---

# Extract list items from a named YAML section. Args: file section
_yaml_list() {
  local file="$1" section="$2"
  [[ -f "$file" ]] || return 0
  awk "/^${section}:/{f=1;next} f&&/^[^ ]/{f=0} f&&/^  - /{sub(/^  - /,\"\");print}" "$file"
}

# Install all deps from one services.yaml file.
_install_yaml_deps() {
  local yaml="$1"
  [[ -f "$yaml" ]] || return 0
  local items

  items="$(_yaml_list "$yaml" "install")"
  if [[ -n "$items" ]]; then
    while IFS= read -r svc; do
      [[ -z "$svc" ]] && continue
      local script="${AI_HOME}/lib/services/${svc}/install"
      [[ ! -f "$script" ]] && script="${AI_HOME}/lib/setup/${svc}/install"
      if [[ -f "$script" ]]; then
        echo "── service: ${svc} ──"
        source "$script" install
      fi
    done <<< "$items"
  fi

  items="$(_yaml_list "$yaml" "plugins")"
  if [[ -n "$items" ]]; then
    while IFS= read -r plugin; do
      [[ -z "$plugin" ]] && continue
      local script="${AI_HOME}/lib/plugins/${plugin}/install"
      if [[ -f "$script" ]]; then
        echo "── plugin: ${plugin} ──"
        source "$script" install
      fi
    done <<< "$items"
  fi
}

# Check one services.yaml file. Prints results; returns missing count.
_check_yaml_deps() {
  local yaml="$1"
  [[ -f "$yaml" ]] || return 0
  local missing=0 items

  items="$(_yaml_list "$yaml" "install")"
  if [[ -n "$items" ]]; then
    echo ""
    echo "Services:"
    while IFS= read -r svc; do
      [[ -z "$svc" ]] && continue
      local script="${AI_HOME}/lib/services/${svc}/install"
      [[ ! -f "$script" ]] && script="${AI_HOME}/lib/setup/${svc}/install"
      if [[ -f "$script" ]]; then
        "${script}" check || { echo "    → ai-stack service install ${svc}"; missing=$(( missing + 1 )); }
      fi
    done <<< "$items"
  fi

  items="$(_yaml_list "$yaml" "plugins")"
  if [[ -n "$items" ]]; then
    echo ""
    echo "Plugins:"
    while IFS= read -r plugin; do
      [[ -z "$plugin" ]] && continue
      local script="${AI_HOME}/lib/plugins/${plugin}/install"
      if [[ -f "$script" ]]; then
        "${script}" check || { echo "    → ai-stack plugin install ${plugin}"; missing=$(( missing + 1 )); }
      fi
    done <<< "$items"
  fi

  items="$(_yaml_list "$yaml" "mcp")"
  if [[ -n "$items" ]]; then
    echo ""
    echo "MCP:"
    while IFS= read -r mcp; do
      [[ -z "$mcp" ]] && continue
      if grep -q "\"${mcp}\"" ~/.claude.json 2>/dev/null; then
        echo "  ✓ mcp: ${mcp}"
      else
        echo "  ✗ mcp: ${mcp}"
        echo "    → ai-stack service install ${mcp}"
        missing=$(( missing + 1 ))
      fi
    done <<< "$items"
  fi

  items="$(_yaml_list "$yaml" "check")"
  if [[ -n "$items" ]]; then
    echo ""
    echo "Binaries:"
    while IFS= read -r bin; do
      [[ -z "$bin" ]] && continue
      if command -v "$bin" &>/dev/null; then
        echo "  ✓ ${bin}"
      else
        echo "  ✗ ${bin} not found"
        missing=$(( missing + 1 ))
      fi
    done <<< "$items"
  fi

  return "$missing"
}

# Check base + profile deps. Prints full report; returns total missing count.
_check_profile_deps() {
  local profile="${1:-$(_current_profile)}"
  local missing=0

  local base_yaml="${AI_HOME}/config/base-services.yaml"
  if [[ -f "$base_yaml" ]]; then
    echo "Base:"
    _check_yaml_deps "$base_yaml" || missing=$(( missing + $? ))
    echo ""
  fi

  local dir
  dir="$(_profile_dir "$profile")"
  echo "Profile: ${profile}"
  if [[ ! -f "$dir/services.yaml" ]]; then
    echo "  (no services.yaml)"
  else
    _check_yaml_deps "$dir/services.yaml" || missing=$(( missing + $? ))
  fi

  echo ""
  if (( missing > 0 )); then
    echo "⚠ ${missing} dep(s) missing. Run: ai-stack install"
    return "$missing"
  fi
  echo "✓ All deps present"
  return 0
}

# --- Commands ---

case "${1:-help}" in
  start)
    if overmind ps &>/dev/null; then
      echo "Stack already running. Use: ai-stack restart"
      exit 1
    fi
    overmind start -D
    _wait_socket_ready
    echo "✓ Stack started. Run: claude"
    overmind ps
    ;;
  stop)
    overmind quit 2>/dev/null || true
    echo "✓ Stack stopped"
    ;;
  restart)
    shift
    if [[ $# -eq 0 ]]; then
      overmind quit 2>/dev/null || true
      _wait_socket_gone
      overmind start -D
    else
      overmind restart "$@"
    fi
    ;;
  status)
    overmind ps 2>/dev/null || echo "Stack not running"
    ;;
  enable)
    shift
    if [[ $# -eq 0 ]]; then
      echo "error: specify at least one service to enable" >&2
      exit 1
    fi
    _validate_services "$@"
    for svc in "$@"; do
      sed -i '' "s/^#${svc}:/${svc}:/" "${OVERMIND_PROCFILE}"
      echo "✓ $svc enabled"
    done
    _restart_if_running
    ;;
  disable)
    shift
    if [[ $# -eq 0 ]]; then
      echo "error: specify at least one service to disable" >&2
      exit 1
    fi
    _validate_services "$@"
    for svc in "$@"; do
      sed -i '' "s/^${svc}:/#${svc}:/" "${OVERMIND_PROCFILE}"
      echo "✓ $svc disabled"
    done
    _restart_if_running
    ;;
  logs)
    shift
    if [[ $# -eq 0 ]]; then
      overmind echo
    else
      overmind connect "$1"
    fi
    ;;
  shell)
    # Run a command with stack env, or spawn a subshell if no args
    shift
    # unset CLAUDE_CODE_USE_BEDROCK which breaks claide CLI in the shell context since it tries to use the cloud API instead of CCR
    unset CLAUDE_CODE_USE_BEDROCK
    if [[ $# -eq 0 ]]; then
      exec $SHELL
    else
      exec "$@"
    fi
    ;;
  profile)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Current profile: $(_current_profile)"
      exit 0
    fi
    if [[ "$(_current_profile)" == "$1" ]]; then
      echo "Profile '$1' already active"
      exit 0
    fi
    # Stop current services before swapping config
    local was_running=false
    if overmind ps &>/dev/null; then
      was_running=true
      echo "✓ Stopping stack for profile switch..."
      overmind quit 2>/dev/null || true
      _wait_socket_gone
    fi
    _activate_profile "$1"
    echo "✓ Profile '$1' activated"
    _check_profile_deps "$1" &>/dev/null || echo "⚠ Deps missing. Run: ai-stack install"
    # Restart with new profile if previously running
    if $was_running; then
      overmind start -D
      echo "✓ Stack restarted"
    fi
    ;;
  check)
    local profile="${2:-$(_current_profile)}"
    if [[ "$profile" == "none" ]]; then
      echo "No active profile. Run: ai-stack profile <name>" >&2
      exit 1
    fi
    _check_profile_deps "$profile"
    ;;
  install)
    local profile="${2:-$(_current_profile)}"
    if [[ "$profile" == "none" ]]; then
      echo "No active profile. Run: ai-stack profile <name>" >&2
      exit 1
    fi
    local dir yaml
    dir="$(_profile_dir "$profile")"
    yaml="$dir/services.yaml"
    if [[ ! -f "$yaml" ]]; then
      echo "No services.yaml for profile '${profile}'"
      exit 0
    fi
    echo "Installing deps for profile: ${profile}"
    _install_yaml_deps "${AI_HOME}/config/base-services.yaml"
    _install_yaml_deps "$yaml"
    echo "✓ Done"
    ;;
  plugin|service)
    local kind="${1}"
    shift
    local action="${1:-}"
    if [[ -z "$action" || ! "$action" =~ ^(install|upgrade|remove)$ ]]; then
      echo "Usage: ai-stack ${kind} {install|upgrade|remove} <name...>" >&2
      exit 1
    fi
    shift
    if [[ $# -eq 0 ]]; then
      echo "error: specify at least one ${kind} name" >&2
      exit 1
    fi
    local lib_dir
    case "$kind" in
      plugin)  lib_dir="${AI_HOME}/lib/plugins" ;;
      service) lib_dir="${AI_HOME}/lib/services" ;;
    esac
    for name in "$@"; do
      local script="${lib_dir}/${name}/install"
      # setup components live under lib/setup/<name>/install
      if [[ ! -f "$script" && "$kind" == "service" ]]; then
        script="${AI_HOME}/lib/setup/${name}/install"
      fi
      if [[ ! -f "$script" ]]; then
        echo "error: unknown ${kind} '${name}'" >&2
        echo "Available: $(ls "${lib_dir}" | tr '\n' ' ')" >&2
        exit 1
      fi
      echo "── ${kind} ${action}: ${name} ──"
      source "$script" "$action"
    done
    ;;
  *)
    echo "Usage: ai-stack {start|stop|restart|status|enable|disable|logs|profile|check|install|plugin|service} [args...]"
    echo ""
    echo "Commands:"
    echo "  start              Start all services (daemonized)"
    echo "  stop               Stop all services"
    echo "  restart [svc]      Restart all or one service"
    echo "  status             Show running processes"
    echo "  enable [svc...]    Enable services in Procfile"
    echo "  disable [svc...]   Disable services in Procfile"
    echo "  logs [svc]         Stream all output, or attach to one service"
    echo "  shell [cmd...]     Run command with stack env, or open subshell"
    echo "  profile [name]     Switch routing profile (default|local|hybrid|cloud)"
    echo "  check [profile]    Check all services.yaml deps for active (or named) profile"
    echo "  install [profile]  Install all missing deps for active (or named) profile"
    echo "  plugin  {install|upgrade|remove} <name...>"
    echo "                     Manage Claude Code plugins"
    echo "  service {install|upgrade|remove} <name...>"
    echo "                     Manage stack services and setup components (e.g. claude-code)"
    echo ""
    echo "Services defined in: ${OVERMIND_PROCFILE}"
    ;;
esac
