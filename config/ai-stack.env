# ai-stack.env

# Project root — resolved from this file's location
export AI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

# Age private key for SOPS secret decryption
export SOPS_AGE_KEY_FILE="${AI_HOME}/secrets/age-key.txt"

# Overmind — service definitions file
export OVERMIND_PROCFILE="${AI_HOME}/config/Procfile"
# Overmind — runtime socket for client commands (ephemeral)
export OVERMIND_SOCKET="${TMPDIR:-/tmp}/ai-stack.overmind.sock"
# Overmind — do not auto-restart crashed processes (use ai-stack restart <svc>)
# export OVERMIND_AUTO_RESTART="all"

# Headroom — port the compression proxy listens on
export HEADROOM_PORT="8787"
# Headroom — compression mode: token, cache
export HEADROOM_MODE="token"
# Headroom — base URL (entry point for Claude Code)
export HEADROOM_BASE_URL="http://localhost:${HEADROOM_PORT}"

# CCR — port the router listens on
export CCR_PORT="3456"

# Claude Code — route all requests through headroom (stack entry point)
export ANTHROPIC_BASE_URL="http://localhost:${HEADROOM_PORT}"
export ANTHROPIC_API_KEY="local"
unset CLAUDE_CODE_USE_BEDROCK

# AWS CLI — profile to use for any AWS bedrock
export AWS_PROFILE=devops
export AWS_REGION=eu-west-1
