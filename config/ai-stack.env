# ai-stack.env

# Project root — resolved from this file's location
export AI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

# run install on profile switch
export AI_STACK_AUTO_INSTALL="true"

# Age private key for SOPS secret decryption
export SOPS_AGE_KEY_FILE="${AI_HOME}/secrets/age-key.txt"

# Overmind — service definitions file
export OVERMIND_PROCFILE="${AI_HOME}/config/Procfile"
# Overmind — runtime socket for client commands (ephemeral)
export OVERMIND_SOCKET="${TMPDIR:-/tmp}/ai-stack.overmind.sock"
# Overmind — do not auto-restart crashed processes (supervised-launch wrapper handles restarts)
# export OVERMIND_AUTO_RESTART="all"
# Allow individual services to die without stopping the whole stack
export OVERMIND_ANY_CAN_DIE="true"

# Headroom — port the compression proxy listens on
export HEADROOM_PORT="8787"
# Headroom — compression mode: token, cache
export HEADROOM_MODE="token"
# Headroom — base URL (entry point for Claude Code)
export HEADROOM_BASE_URL="http://localhost:${HEADROOM_PORT}"
# Headroom — path to store memory data for the compression proxy
export HEADROOM_MEMORY_PATH="${AI_HOME}/config/.headroom"

# Bifrost — port the multi-provider proxy listens on (alternative to LiteLLM, same role)
export BIFROST_PORT="4000"

# Claude Code — route all requests through headroom (stack entry point)
export ANTHROPIC_BASE_URL="http://localhost:${HEADROOM_PORT}"
export ANTHROPIC_API_KEY="local"

# AWS credentials — only needed for bedrock / bedrock-direct profiles
_active_profile="$(cat "${AI_HOME}/config/.active-profile" 2>/dev/null || true)"
if [[ "$_active_profile" == "bedrock" || "$_active_profile" == "bedrock-direct" ]]; then
  export AWS_PROFILE=sbx
  export AWS_REGION=eu-west-1
  eval "$(aws configure export-credentials --profile ${AWS_PROFILE} --format env 2>/dev/null)" || true
fi
unset _active_profile


# Ollama
export OLLAMA_KEEP_ALIVE="5m"        # unload inactive models after 5 minutes
export OLLAMA_FLASH_ATTENTION="1"     # halves KV-cache memory on Apple Silicon
export OLLAMA_KV_CACHE_TYPE="q8_0"   # quantizes KV-cache (halves footprint again)
export OLLAMA_CONTEXT_LENGTH="200000" # default context window
export OLLAMA_NUM_PARALLEL="3"        # concurrent agent request channels
export OLLAMA_MAX_LOADED_MODELS="2"   # models kept in memory simultaneously

# Claude Code - enable tool search and set a more aggressive auto-compaction threshold to keep context size down
export ENABLE_TOOL_SEARCH="true"
export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="70"

# Ensure ~/.local/bin is in PATH (required for uv tool install)
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  PATH="$HOME/.local/bin:$PATH"
  echo "  ⚠ ~/.local/bin is not in PATH"
  echo "  Add to ~/.zshrc: export PATH=\"\$HOME/.local/bin:\$PATH\""
fi
