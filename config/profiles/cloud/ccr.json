{
  "LOG": true,
  "LOG_LEVEL": "info",
  "HOST": "127.0.0.1",
  "PORT": 3456,
  "API_TIMEOUT_MS": "600000",
  "transformers": [],
  "Providers": [
    {
      "name": "bedrock",
      "type": "openai",
      "models": [
        "eu.anthropic.claude-sonnet-4-6",
        "eu.anthropic.claude-haiku-4-5-20251001-v1:0",
        "eu.anthropic.claude-opus-4-6-v1"
      ],
      "api_key": "local",
      "api_base_url": "https://bedrock-mantle.eu-west-1.api.aws/anthropic/v1"
    }
  ],
  "Router": {
    "default": "bedrock,eu.anthropic.claude-sonnet-4-6",
    "background": "bedrock,eu.anthropic.claude-haiku-4-5-20251001-v1:0",
    "think": "bedrock,eu.anthropic.claude-opus-4-6-v1",
    "longContext": "bedrock,eu.anthropic.claude-sonnet-4-6",
    "longContextThreshold": 60000,
    "webSearch": "",
    "image": ""
  },
  "StatusLine": {
    "enabled": true,
    "currentStyle": "default",
    "default": {
      "modules": [
        {
          "type": "workDir",
          "icon": "\udb80\ude4b",
          "text": "{{workDirName}}",
          "color": "bright_blue"
        },
        {
          "type": "gitBranch",
          "icon": "\ud83c\udf3f",
          "text": "{{gitBranch}}",
          "color": "bright_green"
        },
        {
          "type": "model",
          "icon": "\ud83e\udd16",
          "text": "{{model}}",
          "color": "bright_yellow"
        },
        {
          "type": "usage",
          "icon": "\ud83d\udcca",
          "text": "{{inputTokens}} \u2192 {{outputTokens}}",
          "color": "bright_magenta"
        },
        {
          "type": "speed",
          "icon": "\u26a1",
          "text": "{{tokenSpeed}}",
          "color": "bright_green"
        }
      ]
    }
  },
  "APIKEY": "local"
}