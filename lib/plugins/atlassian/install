#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    if claude plugin list 2>/dev/null | grep -q "atlassian@claude-plugins-official"; then
      echo "  uninstalling atlassian…"
      claude plugin uninstall --keep-data atlassian@claude-plugins-official
    fi
    echo "  ✓ atlassian removed"
    ;;
  upgrade)
    echo "  upgrading atlassian…"
    claude plugin update atlassian@claude-plugins-official
    echo "  ✓ atlassian upgraded"
    ;;
  install)
    if claude plugin list 2>/dev/null | grep -q "atlassian@claude-plugins-official"; then
      echo "  ✓ atlassian"
    else
      echo "  installing atlassian…"
      claude plugin install atlassian@claude-plugins-official
      echo "  ✓ atlassian"
    fi

    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac