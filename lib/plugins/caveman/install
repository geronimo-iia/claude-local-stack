#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    if claude plugin list 2>/dev/null | grep -q "caveman@caveman"; then
      echo "  uninstalling caveman…"
      claude plugin uninstall --keep-data caveman@caveman
    fi
    echo "  ✓ caveman removed"
    ;;
  upgrade)
    echo "  upgrading caveman…"
    claude plugin update caveman@caveman
    echo "  ✓ caveman upgraded"
    ;;
  install)
    if claude plugin list 2>/dev/null | grep -q "caveman@caveman"; then
      echo "  ✓ caveman"
    else
      echo "  installing caveman…"
      claude plugin marketplace add JuliusBrussee/caveman
      claude plugin install caveman@caveman
      echo "  ✓ caveman"
    fi

    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac