#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"


configure_claude_md() {
  if ! grep -q "ctx_fetch_and_index" ~/.claude/CLAUDE.md 2>/dev/null; then
    cat >> ~/.claude/CLAUDE.md << 'EOF'

## Context Rules
- Never use WebFetch directly — always use ctx_fetch_and_index
- For multi-file reads, use ctx_batch_execute instead of sequential reads
EOF
    echo "  ✓ context-mode rules added to ~/.claude/CLAUDE.md"
  fi
}

case "${1:-install}" in
  remove)
    if claude plugin list 2>/dev/null | grep -q "context-mode@context-mode"; then
      echo "  uninstalling context-mode…"
      claude plugin uninstall --keep-data context-mode@context-mode
    fi
    echo "  ✓ context-mode removed"
    ;;
  upgrade)
    echo "  upgrading context-mode…"
    claude plugin update context-mode@context-mode
    echo "  ✓ context-mode upgraded"
    ;;
  install)
    if claude plugin list 2>/dev/null | grep -q "context-mode@context-mode"; then
      echo "  ✓ context-mode"
    else
      echo "  installing context-mode…"
      claude plugin marketplace add mksglu/context-mode
      claude plugin install context-mode@context-mode
      echo "  ✓ context-mode"
    fi
    configure_claude_md
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac
