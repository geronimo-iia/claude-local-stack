#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    if claude plugin list 2>/dev/null | grep -q "drawio-diagramming@claude-orchestration"; then
      echo "  uninstalling drawio…"
      claude plugin uninstall --keep-data drawio-diagramming@claude-orchestration
    fi
    echo "  ✓ drawio removed"
    ;;
  upgrade)
    echo "  upgrading drawio…"
    claude plugin update drawio-diagramming@claude-orchestration
    echo "  ✓ drawio upgraded"
    ;;
  install)
    if claude plugin list 2>/dev/null | grep -q "drawio-diagramming@claude-orchestration"; then
      echo "  ✓ drawio (already installed)"
    else
      echo "  installing drawio…"
      claude plugin marketplace add markus41/claude
      claude plugin install drawio-diagramming@claude-orchestration
      claude plugin disable drawio-diagramming@claude-orchestration
      echo "  ✓ drawio (installed, disabled — enable: claude plugin enable drawio-diagramming@claude-orchestration)"
    fi
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac
