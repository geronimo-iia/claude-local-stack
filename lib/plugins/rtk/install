#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

# Install
if command -v rtk &>/dev/null; then
  echo "  ✓ rtk ($(rtk --version))"
else
  echo "  installing rtk…"
  brew install rtk-ai/tap/rtk
  echo "  ✓ rtk ($(rtk --version))"
fi

# Configure claude-code
if ! grep -q "rtk hook claude" ~/.claude/settings.json 2>/dev/null; then
  rtk init --global
fi
echo "  ✓ rtk registered in claude-code"