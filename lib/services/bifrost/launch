#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

# Inject env vars into config template if present (for profiles with cloud API keys)
if [[ -f "${AI_HOME}/config/.bifrost/config.json.tpl" ]]; then
  envsubst < "${AI_HOME}/config/.bifrost/config.json.tpl" > "${AI_HOME}/config/.bifrost/config.json"
fi

exec "${AI_HOME}/lib/utils/supervised-launch" \
  npx -y @maximhq/bifrost \
  -port "${BIFROST_PORT:-4000}" \
  -host "127.0.0.1" \
  -app-dir "${AI_HOME}/config/.bifrost" \
  -log-style pretty
