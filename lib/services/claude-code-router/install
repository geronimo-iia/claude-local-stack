#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

COMPONENT_DIR="${AI_HOME}/lib/services/claude-code-router"
CCR_HOME="${HOME}/.claude-code-router"


case "${1:-install}" in
  remove)
    echo "  uninstalling claude-code-router…"
    npm uninstall -g @musistudio/claude-code-router
    echo "  ✓ claude-code-router removed"
    ;;
  upgrade)
    echo "  upgrading claude-code-router…"
    npm upgrade -g @musistudio/claude-code-router
    echo "  ✓ claude-code-router upgraded"
    ;;
  install)
    # Install
    if ! command -v ccr &>/dev/null; then
      echo "  installing claude-code-router…"
      "$(asdf where nodejs)/bin/npm" install -g @musistudio/claude-code-router
    fi
    echo "  ✓ claude-code-router ($(ccr version))"

    # Generate config from default template with injected port
    if [[ ! -f "${CCR_HOME}/config.json" ]]; then
      mkdir -p "${CCR_HOME}"
      jq --argjson port "${CCR_PORT:-3456}" '.PORT = $port' \
        "${COMPONENT_DIR}/config-default.json" > "${CCR_HOME}/config.json"
      echo "  ✓ default config generated (port ${CCR_PORT:-3456})"
    fi
    ;;
  check)
    command -v ccr &>/dev/null && echo "  ✓ claude-code-router" || { echo "  ✗ claude-code-router"; exit 1; }
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, remove, or check." >&2
    exit 1
    ;;
esac