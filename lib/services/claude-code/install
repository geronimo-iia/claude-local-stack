#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    echo "  uninstalling claude-code…"
    npm uninstall -g @anthropic-ai/claude-code
    echo "  ✓ claude-code removed"
    ;;
  upgrade)
    echo "  upgrading claude…"
    npm upgrade -g @anthropic-ai/claude-code
    echo "  ✓ claude upgraded ($(claude --version))"
    echo "  updating plugins (bun ABI may have changed)…"
    claude plugin list 2>/dev/null | grep '❯' | awk '{print $2}' | while read -r plugin; do
      claude plugin update "${plugin}" 2>/dev/null && echo "  ✓ ${plugin}" || echo "  ⚠ ${plugin} update failed"
    done
    ;;
  install)
    if ! command -v claude &>/dev/null; then
      echo "  installing claude-code…"
      npm install -g @anthropic-ai/claude-code
    fi
    echo "  ✓ claude-code ($(claude --version))"
    ;;
  check)
    command -v claude &>/dev/null && echo "  ✓ claude-code" || { echo "  ✗ claude-code"; exit 1; }
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, remove, or check." >&2
    exit 1
    ;;
esac
