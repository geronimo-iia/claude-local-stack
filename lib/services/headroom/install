#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"


case "${1:-install}" in
  remove)
    echo "  uninstalling headroom…"
    uv tool uninstall --quiet "headroom-ai"
    echo "  ✓ headroom uninstalled"
    ;;
  upgrade)
    echo "  upgrading headroom…"
    uv tool install --force "headroom-ai[all]==0.35.0" --with boto3 --with hnswlib --python "$(asdf where python)/bin/python"
    echo "  ✓ headroom upgraded"
    ;;
  install)
    if ! command -v headroom &>/dev/null; then
      echo "  installing headroom…"
      uv tool install "headroom-ai[all]==0.35.0" --with boto3 --with hnswlib --python "$(asdf where python)/bin/python"
    fi
    echo "  ✓ headroom"

    # create local memory directory if configured
    if [[ "${HEADROOM_MEMORY_PATH}" != "" ]]; then
      mkdir -p "${HEADROOM_MEMORY_PATH}"
    fi

    # Configure headroom mcp claude-code
    if ! grep -q "headroom" ~/.claude.json 2>/dev/null; then
      headroom mcp install --agent claude --proxy-url "http://localhost:${HEADROOM_PORT}" --force
      #sed -i '' "s|\"command\": \"[^\"]*\"|\"command\": \"headroom\"|" ~/.claude.json
    fi
    echo "  ✓ headroom MCP registered in claude-code"
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac