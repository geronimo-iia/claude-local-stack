#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

exec "${AI_HOME}/lib/components/headroom/.venv/bin/headroom" proxy \
  --port "${HEADROOM_PORT:-8787}" \
  --mode "${HEADROOM_MODE:-token}" \
  --anthropic-api-url "http://localhost:${CCR_PORT:-3456}" \
  --no-telemetry \
  --workers "${HEADROOM_WORKERS:-1}"
  # --memory            # persistent cross-session memory
  # --learn             # learn from failures, writes to MEMORY.md
  # --code-aware        # AST-based code compression (requires tree-sitter)
