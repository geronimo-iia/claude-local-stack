#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../../../config/ai-stack.env"
source "${AI_HOME}/lib/utils/load-service-env" "headroom"

# Force region for boto3
export AWS_DEFAULT_REGION="${AWS_REGION:-eu-west-1}"

exec "${AI_HOME}/lib/utils/supervised-launch" \
  "headroom" proxy \
  --port "${HEADROOM_PORT:-8787}" \
  --mode "${HEADROOM_MODE:-token}" \
  --backend bedrock \
  --region "${AWS_REGION}" \
  --bedrock-profile "${AWS_PROFILE:-default}" \
  --memory \
  --memory-db-path "${HEADROOM_MEMORY_PATH}/memory.db" \
  --code-aware \
  --no-telemetry \
  --no-subscription-tracking \
  --workers "${HEADROOM_WORKERS:-1}" \
  --log-file "${AI_HOME}/logs/headroom-$(date +%Y-%m-%d).log"
  # --learn             # learn from failures, writes to MEMORY.md
  # --code-aware        # AST-based code compression (requires tree-sitter)
