#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    echo "  litellm runs via uvx — no permanent install to remove"
    echo "  To clear cached env: uv cache clean"
    ;;
  upgrade)
    echo "  warming uvx cache for latest litellm[proxy]…"
    uvx --from "litellm[proxy]" litellm --version
    echo "  ✓ litellm cache refreshed"
    ;;
  install)
    echo "  warming uvx cache for litellm[proxy]…"
    uvx --from "litellm[proxy]" litellm --version
    echo "  ✓ litellm (via uvx)"
    ;;
  check)
    command -v uvx &>/dev/null && echo "  ✓ litellm (via uvx)" || { echo "  ✗ uvx not found"; exit 1; }
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, remove, or check." >&2
    exit 1
    ;;
esac
