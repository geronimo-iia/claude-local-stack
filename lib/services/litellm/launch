#!/bin/zsh
set -euo pipefail

source "$(dirname "$0")/../../../config/ai-stack.env"
source "${AI_HOME}/lib/utils/load-service-env" "litellm"

export PYTHONPATH="${AI_HOME}/lib/services/litellm${PYTHONPATH:+:$PYTHONPATH}"

exec "${AI_HOME}/lib/utils/supervised-launch" \
  uvx --from "litellm[proxy]" litellm \
  --config "${AI_HOME}/config/litellm.yaml" \
  --port "${LITELLM_PORT:-4000}"
