#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    echo "  uninstalling llm-wiki…"
    brew uninstall geronimo-iia/tap/llm-wiki
    echo "  ✓ llm-wiki uninstalled"
    ;;
  upgrade)
    echo "  upgrading llm-wiki…"
    brew update
    brew upgrade geronimo-iia/tap/llm-wiki
    pkill -f llm-wiki || true
    echo "  ✓ llm-wiki upgraded"
    ;;
  install)
    if ! command -v llm-wiki &>/dev/null; then
      echo "  installing llm-wiki…"
      brew install geronimo-iia/tap/llm-wiki
    fi
    echo "  ✓ llm-wiki $(llm-wiki --version)"
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac
