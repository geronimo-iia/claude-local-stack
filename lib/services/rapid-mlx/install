#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"


case "${1:-install}" in
  remove)
    echo "  uninstalling rapid-mlx…"
    uv tool uninstall --quiet "rapid-mlx"
    echo "  ✓ rapid-mlx uninstalled"
    ;;
  upgrade)
    echo "  upgrading rapid-mlx…"
    uv tool install --force "rapid-mlx==0.12.11" --with mlx-embeddings --python "$(asdf where python)/bin/python"
    echo "  ✓ rapid-mlx upgraded"
    ;;
  install)
    if ! command -v rapid-mlx &>/dev/null; then
      echo "  installing rapid-mlx…"
      uv tool install "rapid-mlx==0.12.11" --with mlx-embeddings --python "$(asdf where python)/bin/python"
    fi
    echo "  ✓ rapid-mlx"
    ;;
  check)
    command -v rapid-mlx &>/dev/null && echo "  ✓ rapid-mlx" || { echo "  ✗ rapid-mlx"; exit 1; }
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, remove, or check." >&2
    exit 1
    ;;
esac