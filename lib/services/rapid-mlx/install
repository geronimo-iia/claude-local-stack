#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

if ! command -v rapid-mlx &>/dev/null; then
  echo "  installing rapid-mlx…"
  uv tool install "rapid-mlx==0.6.50" --with mlx-embeddings --python "$(asdf where python)/bin/python"
fi
echo "  ✓ rapid-mlx"
