#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

SERVICE_DIR="${AI_HOME}/lib/components/rapid-mlx"

if [[ -d "${SERVICE_DIR}/.venv" ]]; then
  rm -rf "${SERVICE_DIR}/.venv"
  echo "  ✓ rapid-mlx removed"
else
  echo "  ✓ rapid-mlx (not installed)"
fi
