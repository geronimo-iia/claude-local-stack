#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

case "${1:-install}" in
  remove)
    echo "  uninstalling voicemode…"
    uv tool uninstall --quiet "voicemode"
    echo "  ✓ voicemodeuninstalled"
    ;;
  upgrade)
    echo "  upgrading voicemode…"
    uv tool upgrade --quiet "voicemode" --python "$(asdf where python)/bin/python"
    echo "  ✓ voicemode upgraded"
    ;;
  install)
    if ! command -v voicemode &>/dev/null; then
      echo "  installing voicemode"
      uv tool install "voice-mode" --python "$(asdf where python)/bin/python"
      echo "  installing whisper"
      voicemode whisper service install --use-gpu 
      echo "  installing kokoro"
      voicemode kokoro install
    fi
    echo "  ✓ voicemode"

    if ! grep -q "voicemode" ~/.claude.json 2>/dev/null; then
      claude mcp add --transport http voicemode http://localhost:8765/mcp
    fi
    ;;
  *)
    echo "Unsupported command: ${1:-install}. Use: install (default), upgrade, or remove." >&2
    exit 1
    ;;
esac



