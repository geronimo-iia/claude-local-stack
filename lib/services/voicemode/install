#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

SERVICE_DIR="${AI_HOME}/lib/services/voicemode"

TOOLS=(ffmpeg node portaudio)  # host-level utilities, no version pinning

for tool in "${TOOLS[@]}"; do
  if brew list "${tool}" &>/dev/null; then
    brew upgrade "${tool}" 2>/dev/null || true
    echo "  ✓ ${tool}"
  else
    echo "  installing ${tool}…"
    brew install "${tool}"
  fi
done


if ! command -v voicemode &>/dev/null; then
  echo "  installing voicemode"
  uv tool install "voice-mode" --python "$(asdf where python)/bin/python"
fi
echo "  ✓ voicemode"

