#!/bin/zsh
set -euo pipefail

[[ -z "${AI_HOME:-}" ]] && source "$(dirname "$0")/../../../config/ai-stack.env"

if command -v claude &>/dev/null; then
  echo "  ✓ claude-code ($(claude --version))"
  return 0
fi

echo "  installing claude-code…"
npm install -g @anthropic-ai/claude-code
echo "  ✓ claude-code ($(claude --version))"

