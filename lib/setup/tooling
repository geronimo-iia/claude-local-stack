#!/bin/zsh
set -euo pipefail

# ffmpeg node portaudio are required by voicemode
# we also need jq, yq, curl, and hf for various scripts and utilities
TOOLS=(jq yq curl hf ffmpeg node portaudio)  # host-level utilities, no version pinning

echo "── tooling ──"

echo "checking tools: ${TOOLS[*]}"
for tool in "${TOOLS[@]}"; do
  if brew list "${tool}" &>/dev/null; then
    brew upgrade "${tool}" 2>/dev/null || true
    echo "  ✓ ${tool}"
  else
    echo "  installing ${tool}…"
    brew install "${tool}"
  fi
done

echo "── tooling done ──"
